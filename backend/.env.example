# Runtime: Neon pooled URL (hostname contains -pooler)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@EP-ID-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Migration only: Neon direct URL (hostname does not contain -pooler)
DATABASE_URL_MIGRATIONS=postgresql+psycopg://USER:PASSWORD@EP-ID.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

APP_ENV=development
JWT_SECRET_KEY=replace-with-a-64-character-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
GOOGLE_OAUTH_WEB_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Background removal service
RAPIDAPI_KEY=

# Clothing image tagging — up to 3 Gemini keys from separate GCP projects.
# Keys are tried in order; a daily-exhausted key is skipped for the rest of
# the day (UTC). Auto-tagging is disabled when no keys are configured.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash

# Outfit suggestions
GROQ_API_KEY=
GROQ_OUTFIT_MODEL=qwen/qwen3.8-27b

# Required on Vercel: authorizes its daily Cloudinary cleanup cron.
# Optional locally unless you call /api/v1/maintenance/reconcile/cloudinary yourself.
CRON_SECRET=replace-with-a-random-32-character-secret
